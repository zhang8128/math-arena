MATHLOOP_DATABASE_URL=postgresql://mathloop:mathloop@localhost:55432/mathloop
MATHLOOP_ARTIFACT_ROOT=.mathloop/artifacts
MATHLOOP_INCOMING_ROOT=data/incoming
MATHLOOP_DAILY_API_BUDGET_USD=5
MATHLOOP_MAX_EXPERIMENT_SECONDS=300
MATHLOOP_LEASE_SECONDS=420
MATHLOOP_MAX_MODEL_OUTPUT_TOKENS=4096
MATHLOOP_MAX_API_COST_USD_PER_EXPERIMENT=1
# OPENAI_API_KEY is optional. Do not commit it.

# -- Codex supervisor foundation (mutually exclusive with the OpenAI API lane) --
# Reuses saved ChatGPT Codex CLI authentication (`codex login`). Never set
# OPENAI_API_KEY or CODEX_API_KEY alongside Codex: Codex accounting is turns
# and tokens only, never a dollar-equivalent receipt, and the two external
# providers must never both be live in one runtime.
MATHLOOP_CODEX_ENABLED=false
MATHLOOP_CODEX_CLI_PATH=codex
MATHLOOP_CODEX_REPO_ROOT=.
MATHLOOP_CODEX_WORKTREE_ROOT=.mathloop/codex-worktrees
# The operator's own, already-authenticated Codex CLI store. Never derived
# from CODEX_WORKTREE_ROOT (agent-writable disposable scratch space) and
# never seeded or written to by mathloop itself.
MATHLOOP_CODEX_HOME=~/.codex
MATHLOOP_CODEX_DAILY_TURN_LIMIT=100
MATHLOOP_CODEX_CONCURRENT_TURN_LIMIT=4
MATHLOOP_CODEX_TURN_TIMEOUT_SECONDS=1800
# Role limits must sum to MATHLOOP_CODEX_DAILY_TURN_LIMIT above.
MATHLOOP_CODEX_LUNA_TURN_LIMIT=40
MATHLOOP_CODEX_TERRA_TURN_LIMIT=40
MATHLOOP_CODEX_SOL_TURN_LIMIT=20
# Actively enforced today, not inert: reserve_codex_turn caps every NON-Sol
# role's daily total at (DAILY_TURN_LIMIT - RESERVED_SOL_TURNS), so with the
# values above a Luna turn is denied once the day reaches 90 turns, not 100.
# Sol itself is exempt and competes against the full daily limit.
# What IS unconsumed in this foundation phase is the reserved Sol turns
# themselves: runtime.py registers the Luna role only, so nothing ever spends
# them. A later promotion-plan review gate is their intended consumer.
MATHLOOP_CODEX_RESERVED_SOL_TURNS=10
MATHLOOP_CODEX_MODEL_LUNA=gpt-5.6-luna
MATHLOOP_CODEX_MODEL_TERRA=gpt-5.6-terra
MATHLOOP_CODEX_MODEL_SOL=gpt-5.6-sol
MATHLOOP_CODEX_MIN_CLI_VERSION=0.145.0
# Not a mathloop setting: read directly from the process environment by the
# test suite. Never set this except immediately before an explicitly
# operator-approved run of `pytest -m live_codex` -- it spends one real,
# credit-consuming ChatGPT Codex turn. Do not commit it set to 1.
# MATHLOOP_RUN_LIVE_CODEX=1
