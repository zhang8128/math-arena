#!/usr/bin/env python3
"""Blind self-exam. Runs every item and records the result over time.

Why this exists, in one sentence: **every instrument in this arena was graded by
its author**, and on 2026-07-25 that let a harness score two proofs by editing a
comment. The rule here is that the grader must not share an implementation with
the examinee.

This is also the instrumentation gap the arena has carried since it was built —
"is turn 50 better than turn 5" was unanswerable because nothing was measured
over time. `results.jsonl` is that record.

  exam              run everything, human-readable
  exam --report     JSON for a Claude Code hook (silent when all pass)
  exam --history    what has changed over time
"""

import json
import sys
import time
import traceback
from pathlib import Path

HERE = Path(__file__).resolve().parents[1] / "exam"
sys.path.insert(0, str(HERE))
RESULTS = HERE / "results.jsonl"

import items as items_mod  # noqa: E402


def run():
    out = []
    for fn in items_mod.ITEMS:
        t0 = time.time()
        try:
            name, level, ok, detail = fn()
        except Exception as e:
            name, level, ok = getattr(fn, "__name__", "?"), -1, False
            detail = f"ITEM RAISED: {e.__class__.__name__}: {e}"
            traceback.print_exc(file=sys.stderr)
        out.append({"name": name, "level": level, "ok": bool(ok),
                    "detail": detail, "secs": round(time.time() - t0, 1)})
    return out


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""

    if mode == "--history":
        if not RESULTS.exists():
            print("no history yet")
            return 0
        runs = [json.loads(l) for l in RESULTS.read_text().splitlines() if l.strip()]
        print(f"{len(runs)} recorded runs\n")
        print(f"{'when':20} {'pass':>6} {'fail':>6}  failing items")
        for r in runs:
            bad = [i["name"] for i in r["items"] if not i["ok"]]
            print(f"{r['when']:20} {r['passed']:6} {r['failed']:6}  {', '.join(bad) or '—'}")
        return 0

    res = run()
    passed = sum(1 for r in res if r["ok"])
    failed = len(res) - passed

    RESULTS.parent.mkdir(parents=True, exist_ok=True)
    with RESULTS.open("a") as fh:
        fh.write(json.dumps({
            "when": time.strftime("%Y-%m-%d %H:%M"),
            "passed": passed, "failed": failed, "items": res}) + "\n")

    if mode == "--report":
        if failed:
            bad = "; ".join(f"{r['name']}: {r['detail']}" for r in res if not r["ok"])
            print(json.dumps({"systemMessage": f"📋 blind exam: {failed} FAILING — {bad[:300]}"}))
        return 0

    lvl = None
    for r in sorted(res, key=lambda r: (r["level"], r["name"])):
        if r["level"] != lvl:
            lvl = r["level"]
            names = {0: "arithmetic — if these fail nothing above matters",
                     1: "the arena's own lib, checked against independent sources",
                     2: "TRAPS — the failure modes this arena actually commits",
                     -1: "items that crashed"}
            print(f"\n── level {lvl}: {names.get(lvl,'')}")
        mark = "✓" if r["ok"] else "✗"
        print(f"  {mark} {r['name']:38} {r['detail'][:60]}  [{r['secs']}s]")
    print(f"\n{passed} passed, {failed} failed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
