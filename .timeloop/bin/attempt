#!/usr/bin/env python3
"""Batch proof attempts against unproved statements in formal-conjectures.

The premise, and the reason this exists: a proof attempt is *cheap and its
verdict is unambiguous*. It compiles or it does not. That is the chess evaluator
property, and it means the right strategy is breadth — fire many attempts and let
the checker sort them — rather than carefully reasoning about one.

For each `sorry` it substitutes a candidate tactic, compiles that single file,
and records the verdict. Nothing is written back; the working tree is restored
after every attempt.

  attempt --list            show candidates without attempting
  attempt -n 8              attempt the 8 smallest candidates
  attempt --cat textbook    restrict to a category
  attempt --sweep           long run over every candidate

Sweep mode writes one JSON line per candidate *as it finishes*, so a partial
run is still usable and progress is checkable at any moment. It resumes by
skipping candidates already present in the output file, and it stops at
--max-hours. Both properties exist because on 2026-07-25 two background jobs
ran for hours and wrote zero bytes.
"""

import argparse
import pathlib
import re
import subprocess
import sys
import time

FC = pathlib.Path(__file__).resolve().parents[1] / "lean" / "formal-conjectures"

# Ordered cheapest-first. `native_decide` is last: it trusts the compiler rather
# than the kernel, so a success there is weaker evidence than the others.
TACTICS = ["rfl", "decide", "norm_num", "simp", "omega", "native_decide"]


TIERS = ["test", "textbook", "research solved", "research open", "API"]


def candidates(cat_filter=None, all_tiers=False):
    out = []
    for f in sorted((FC / "FormalConjectures").rglob("*.lean")):
        txt = f.read_text(errors="ignore")
        for blk in re.split(r"(?=@\[category)", txt)[1:]:
            m = re.match(r"@\[category\s+([^,\]]+)", blk)
            if not m or "sorry" not in blk:
                continue
            cat = m.group(1).strip()
            if cat_filter and cat != cat_filter:
                continue
            allowed = TIERS if all_tiers else ("test", "textbook")
            if cat not in allowed:
                continue
            nm = re.search(r"\b(?:theorem|lemma)\s+([\w.]+)", blk)
            stmt = blk.split(":=")[0]
            out.append(
                {
                    "file": f,
                    "cat": cat,
                    "name": nm.group(1) if nm else "?",
                    "size": len(stmt),
                    "stmt": " ".join(stmt.split()),
                }
            )
    # tractability tier first, then statement size within tier
    out.sort(key=lambda c: (TIERS.index(c["cat"]) if c["cat"] in TIERS else 9, c["size"]))
    return out


def try_tactic(c, tactic, timeout=120):
    """Substitute one sorry with a tactic, compile that file, restore. Verdict only."""
    path = c["file"]
    original = path.read_text()
    # replace only the sorry belonging to THIS declaration
    pat = re.compile(
        r"(\b(?:theorem|lemma)\s+" + re.escape(c["name"]) + r"\b.*?)\bsorry\b",
        re.DOTALL,
    )
    patched, n = pat.subn(r"\1" + tactic, original, count=1)
    if n == 0:
        return "no-substitution"
    try:
        path.write_text(patched)
        r = subprocess.run(
            ["lake", "env", "lean", str(path.relative_to(FC))],
            cwd=FC,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        if r.returncode == 0 and "sorry" not in r.stderr:
            return "PROVED"
        err = (r.stderr or r.stdout).strip().splitlines()
        first = next((l for l in err if "error" in l.lower()), err[0] if err else "?")
        return first[:90]
    except subprocess.TimeoutExpired:
        return f"timeout>{timeout}s"
    finally:
        path.write_text(original)  # always restore


def sweep(a):
    import json, os
    out = pathlib.Path(a.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    done = set()
    if out.exists():
        for line in out.read_text().splitlines():
            try:
                done.add(json.loads(line)["key"])
            except Exception:
                pass
    cs = candidates(all_tiers=True)
    todo = [c for c in cs if f"{c['file'].name}:{c['name']}" not in done]
    print(f"sweep: {len(cs)} candidates, {len(done)} already done, {len(todo)} to go",
          flush=True)
    t0 = time.time()
    proved = 0
    with out.open("a") as fh:
        for i, c in enumerate(todo, 1):
            if time.time() - t0 > a.max_hours * 3600:
                print(f"stopping at --max-hours={a.max_hours}", flush=True)
                break
            key = f"{c['file'].name}:{c['name']}"
            got, tried = None, {}
            for t in TACTICS:
                v = try_tactic(c, t, timeout=60)
                tried[t] = v
                if v == "PROVED":
                    got = t
                    break
            if got:
                proved += 1
            fh.write(json.dumps({"key": key, "cat": c["cat"], "size": c["size"],
                                 "proved_by": got, "stmt": c["stmt"][:200],
                                 "tried": tried}) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
            if i % 10 == 0 or got:
                el = (time.time() - t0) / 60
                print(f"[{i}/{len(todo)}] {el:.0f}m  proved={proved}"
                      + (f"  <-- {key} by {got}" if got else ""), flush=True)
    print(f"sweep done: {proved} proved in {(time.time()-t0)/60:.0f}m", flush=True)
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-n", type=int, default=6)
    ap.add_argument("--cat")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--sweep", action="store_true")
    ap.add_argument("--out", default=".timeloop/runs/sweep.jsonl")
    ap.add_argument("--max-hours", type=float, default=10.0)
    a = ap.parse_args()

    if a.sweep:
        return sweep(a)

    cs = candidates(a.cat)
    if a.list:
        print(f"{len(cs)} unproved test/textbook statements")
        for c in cs[: a.n]:
            print(f"  [{c['cat']:8}] {c['file'].name:20} {c['name']:16} {c['stmt'][:70]}")
        return 0

    print(f"attempting {min(a.n, len(cs))} of {len(cs)} candidates, "
          f"{len(TACTICS)} tactics each, stopping at first success\n")
    proved, failed = [], []
    t0 = time.time()
    for c in cs[: a.n]:
        print(f"── {c['file'].name}:{c['name']}  ({c['cat']})")
        print(f"   {c['stmt'][:88]}")
        got = None
        for t in TACTICS:
            v = try_tactic(c, t)
            mark = "✓" if v == "PROVED" else "·"
            print(f"   {mark} {t:14} {v if v != 'PROVED' else ''}")
            if v == "PROVED":
                got = t
                break
        (proved if got else failed).append((c, got))
        print()
    el = time.time() - t0
    print(f"═══ {len(proved)} proved / {len(cs[:a.n])} attempted  [{el:.0f}s] ═══")
    for c, t in proved:
        print(f"   ✓ {c['file'].name}:{c['name']}  by {t}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
